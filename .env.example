# MedBridge — required environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM (Gemini) ─────────────────────────────────────────────────────────────
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ── App behaviour ─────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to use cached extractions (no network needed for demo)
DEMO_MODE=false

# Confidence threshold (0-1). Fields below this get the amber "please check" tag.
CONF_THRESHOLD=0.6

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Optional: override Tesseract binary path ──────────────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
